void setup() {
  // Initialize the display (use INITR_BLACKTAB or INITR_GREENTAB depending on your screen tab)
  tft.initR(INITR_BLACKTAB); 
  tft.setRotation(1);
  
  // Clear screen to black
  tft.fillScreen(ST7735_BLACK);
  
  // Set text color to white and size to 2
  tft.setTextColor(ST7735_WHITE);
  tft.setTextSize(1);
  
  // Position cursor (x, y) and print text
  tft.setCursor(10, 40);
}

void loop() {
  // Nothing needed here for static text
  tft.drawRGBBitmap(64, 48, pixilart_drawing_1_, 32, 32);
  delay(200);
